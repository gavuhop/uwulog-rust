{
  "uwu-session-context": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/hooks/session_start.py",
        "timeout": 10
      }
    ]
  },
  "uwu-command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hooks/pre_command_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "uwu-write-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hooks/pre_write_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "uwu-stop-arch-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/hooks/stop_arch_gate.py",
        "timeout": 20
      }
    ]
  }
}
