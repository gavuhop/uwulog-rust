{
  "uwu-session-context": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/hooks/session_start.sh",
        "timeout": 10
      }
    ]
  },
  "uwu-command-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hooks/pre_command_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
