[
  {
    "label": "Check",
    "command": "cargo check --workspace"
  },
  {
    "label": "Test",
    "command": "cargo nextest run --workspace"
  },
  {
    "label": "Clippy",
    "command": "cargo clippy --workspace --all-targets --all-features"
  },
  {
    "label": "Format",
    "command": "cargo fmt --all -- --check"
  },
  {
    "label": "Build",
    "command": "cargo build --workspace"
  },
  {
    "label": "Run app test (JSON gen_logs)",
    "command": "cargo run -p uwu-gui -- -r \"go run gen_logs.go -rate 50\""
  },
  {
    "label": "Run app test plain (ANSI gen_plain_logs)",
    "command": "cargo run -p uwu-gui -- -r \"go run gen_plain_logs.go -rate 10 -stdout\""
  },
  {
    "label": "Run app test JSON (Zap gen_plain_logs)",
    "command": "cargo run -p uwu-gui -- -r \"go run gen_plain_logs.go -rate 10 -json\""
  },
  {
    "label": "Build Release",
    "command": "cargo run --release --bin uwu-gui"
  }
]